programa {
  funcao inicio() {
    inteiro darBanho = 10
      leia (darBanho)
        se (darBanho < 10){
          escreva("Hora do banho")
    }   senao se (darBanho >10)
          escreva("eRRor")
        senao
          escreva("Ja estou limpo")
  }
}

